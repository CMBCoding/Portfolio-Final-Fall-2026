<!DOCTYPE html>
<html lang="en">
<%- include('partials/head.ejs') %>
<body>
    <header id="header">
        <h1 class="gothic">Home</h1>
        <%- include('partials/nav.ejs') %>
    </header>
    <main class="gothic-thin">
        <form action="/login" method="POST">

            <div id="login-field">
                <legend>User Login</legend>
                <% if (error) { %>
                    <p id="login-error"><%= error %></p>
                <% } %>
                <label for="login_user">Username:</label>
                <input type="text" name="login_user" id="login_user">
                <!-- <span class="error-msg">Please enter a username</span> -->
                
                <label for="login_pwd">Password:</label>
                <input type="password" name="login_pwd" id="login_pwd">
                <!-- <span class="error-msg">Please enter a password</span> -->
                
                <button type="submit">Login</button>
            </div>
        </form>
    </main>
</body>
</html>